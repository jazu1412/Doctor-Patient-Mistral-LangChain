# API base for the React app (must include /api/v1).
# Change this when your Mac’s LAN IP changes (home vs school Wi‑Fi).
#
# Examples:
#   Local browser only:     http://localhost:8000/api/v1
#   Phone on same Wi‑Fi:    http://192.168.1.50:8000/api/v1
#
# Leave unset to auto-use: same host as the page + port 8000 (handy for phone without editing).
VITE_API_BASE_URL=http://localhost:8000/api/v1
