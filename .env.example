# Backend API configuration
CORS_ORIGINS=http://localhost:3000

# Mistral AI configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# ChromaDB configuration
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=patient-doctor
COLLECTION_NAME=doctor_embeddings
PATIENT_COLLECTION_NAME=patient_cases

# Model configuration
EMBEDDING_MODEL=mistral-embed
CHAT_MODEL=mistral-small-latest

# Cloud SQL (MySQL)
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=3306
CLOUD_SQL_USER=your_mysql_username
CLOUD_SQL_PASSWORD=your_mysql_password
CLOUD_SQL_DATABASE=doctor_appointments_db

# Optional Timescale connection used by legacy availability helpers
DB_CONNECTION=

# Frontend (Vite): put API URL in frontend/.env — see frontend/.env.example
# (Root .env is for the Python backend; Vite does not load it for npm run dev.)
ENABLE_ZIP_MATCHING=false

# Booking email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=medimatchai7@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=medimatchai7@gmail.com
